lets # ============================================================================
# BEACON Environment Configuration
# ============================================================================
# ⚠️  SECURITY WARNING: NEVER commit the actual .env file to version control!
# ⚠️  Replace ALL placeholder values before deploying to production!
# ⚠️  Using placeholder values in production will cause deployment to FAIL.
# ============================================================================

# Environment (development, staging, production)
ENVIRONMENT=development

# Core schema and scan defaults
SCHEMA_VERSION=3.2
DEFAULT_SCAN_MODE=fast

# Production scan caps
MAX_SCAN_GLOBAL_CAP=80
MAX_CONCURRENT_SITE_AUDITS=3
DASHBOARD_DEEP_SCAN_MAX_PAGES=12
DASHBOARD_MAX_SCAN_MAX_PAGES=25

# ============================================================================
# LLM / AI Configuration (REQUIRED)
# ============================================================================
# Get API key from: https://build.nvidia.com/ or https://featherless.ai/
NVIDIA_API_KEY=your-nvidia-api-key-here
LLM_MODEL=meta/llama-3.1-70b-instruct
LLM_BASE_URL=https://integrate.api.nvidia.com/v1

# ============================================================================
# Supabase Integration (REQUIRED for persistence)
# ============================================================================
# Create project at: https://supabase.com/dashboard
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key-here

# Embeddings / vector store
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_STORE=chromadb
CHROMA_PERSIST_DIR=./chroma_db

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# ⚠️  In production, set this to your actual frontend domain(s), comma-separated
# Example: https://beacon.yourdomain.com,https://app.yourdomain.com
BACKEND_CORS_ORIGINS=http://localhost:3000
BACKEND_LOG_LEVEL=INFO

# ============================================================================
# Security Configuration
# ============================================================================

# CORS Origins (comma-separated list of allowed frontend origins)
# For production on Vercel: https://your-app.vercel.app
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate Limiting (per client, per minute/hour)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Request Size Limits (in MB)
MAX_REQUEST_SIZE_MB=10

# Optional project metadata
FIREBASE_PROJECT_ID=

# Observability
METRICS_WINDOW_SIZE=1000
LOGS_DIR=./logs
TELEMETRY_FILENAME=telemetry.jsonl
APP_LOG_FILENAME=app.log

# Alerting
ALERT_WEBHOOK_URL=
TIMEOUT_SPIKE_THRESHOLD=0.02
ENRICHMENT_FALLBACK_SPIKE_THRESHOLD=0.10
LONG_RUNNING_AUDIT_SECONDS=180
LLM_FAILURE_BURST_COUNT=3
LLM_FAILURE_BURST_WINDOW_SECONDS=300

# ============================================================================
# API Authentication (REQUIRED - Generate secure random keys!)
# ============================================================================
# ⚠️  CRITICAL: Generate unique secure keys for each environment!
# Use: python -c "import secrets; print(secrets.token_urlsafe(32))"
# 
# These keys provide access control to your API:
# - viewer: Read-only access to audits and history
# - auditor: Can run audits and submit feedback
# - admin: Full access including metrics and cache management
AUTH_ENABLED=true
AUTH_KEY_STORE_PATH=./app/data/api_keys.json
BOOTSTRAP_VIEWER_API_KEY=generate-secure-key-for-viewer-role
BOOTSTRAP_AUDITOR_API_KEY=generate-secure-key-for-auditor-role
BOOTSTRAP_ADMIN_API_KEY=generate-secure-key-for-admin-role

# Feature flags
BEACON_AI_ENABLED=true

# Enrichment and LLM budget controls
ENRICHMENT_ENABLE_LLM_CACHE=true
LLM_CACHE_MAX_ENTRIES=2000
ENRICHMENT_MAX_CONCURRENCY=2
ENRICHMENT_RETRY_ATTEMPTS=3
ENRICHMENT_RETRY_BASE_DELAY_SECONDS=0.4
ENRICHMENT_RETRY_MAX_DELAY_SECONDS=3.0
MAX_TOKENS_PER_AUDIT=12000
MAX_LLM_COST_PER_AUDIT=2.5


# Test user credentials (create in Supabase Auth dashboard)
TEST_USER_A_EMAIL=test_user_a@yourproject.dev
TEST_USER_A_PASSWORD=your_test_password_here
TEST_USER_B_EMAIL=test_user_b@yourproject.dev
TEST_USER_B_PASSWORD=your_test_password_here