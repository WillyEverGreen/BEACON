# BEACON — Environment Configuration Example

# Copy this file to .env and fill in your secrets.
# DO NOT push your actual .env file to version control.

# ── Featherless AI (OpenAI-compatible) ─────────────────────
# Obtain your key from https://featherless.ai/
FEATHERLESS_API_KEY=your_featherless_api_key_here
FEATHERLESS_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1

# ── Embedding Model (Local) ───────────────────────────────
# No API key required for local sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Vector Store ─────────────────────────────────────────
VECTOR_STORE=chromadb
CHROMA_PERSIST_DIR=./chroma_db

# ── Backend Configuration ────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Update this with your frontend URL for CORS
BACKEND_CORS_ORIGINS=http://localhost:3000

# ── Next.js Frontend ─────────────────────────────────────
# Only required if your backend is not on localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Firebase (Optional / Future Auth) ─────────────────────
FIREBASE_PROJECT_ID=your_project_id_here
