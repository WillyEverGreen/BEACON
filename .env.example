# BEACON Environment Template
# Copy to .env for local/dev and set real values.
# Never commit real secrets.

# Core schema and scan defaults
SCHEMA_VERSION=3.1
DEFAULT_SCAN_MODE=fast

# Featherless AI (OpenAI-compatible)
FEATHERLESS_API_KEY=replace_me
FEATHERLESS_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1

# Embeddings / vector store
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_STORE=chromadb
CHROMA_PERSIST_DIR=./chroma_db

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000
BACKEND_LOG_LEVEL=INFO

# Optional project metadata
FIREBASE_PROJECT_ID=

# Persistence
DB_URL=sqlite:///./beacon.db
DB_ECHO=false

# Observability
METRICS_WINDOW_SIZE=1000
LOGS_DIR=./logs
TELEMETRY_FILENAME=telemetry.jsonl
APP_LOG_FILENAME=app.log

# Alerting
ALERT_WEBHOOK_URL=
TIMEOUT_SPIKE_THRESHOLD=0.02
ENRICHMENT_FALLBACK_SPIKE_THRESHOLD=0.10
LONG_RUNNING_AUDIT_SECONDS=180
LLM_FAILURE_BURST_COUNT=3
LLM_FAILURE_BURST_WINDOW_SECONDS=300

# API authentication
AUTH_ENABLED=true
AUTH_KEY_STORE_PATH=./app/data/api_keys.json
# Replace bootstrap keys before deploying shared environments.
BOOTSTRAP_VIEWER_API_KEY=replace_me_viewer
BOOTSTRAP_AUDITOR_API_KEY=replace_me_auditor
BOOTSTRAP_ADMIN_API_KEY=replace_me_admin

# Enrichment and LLM budget controls
ENRICHMENT_ENABLE_LLM_CACHE=true
LLM_CACHE_MAX_ENTRIES=2000
ENRICHMENT_MAX_CONCURRENCY=2
ENRICHMENT_RETRY_ATTEMPTS=3
ENRICHMENT_RETRY_BASE_DELAY_SECONDS=0.4
ENRICHMENT_RETRY_MAX_DELAY_SECONDS=3.0
MAX_TOKENS_PER_AUDIT=12000
MAX_LLM_COST_PER_AUDIT=2.5
LLM_PROMPT_COST_PER_1K_TOKENS=0
LLM_COMPLETION_COST_PER_1K_TOKENS=0

# Frontend (optional helper)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Phase 7 Node API execution layer
PORT=3000
API_VERSION=1.0.0
NODE_ENV=development
LOG_LEVEL=info

AUDIT_TIMEOUT_MS=180000
REQUEST_TIMEOUT_MS=30000

RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=60000

MAX_URL_LENGTH=2048
DEFAULT_AUDIT_MODE=balanced

ENGINE_PYTHON_CMD=python
ENGINE_RUNNER_PATH=api/services/run_beacon_audit.py
