{"url": "https://conference.webaim.org/register", "silo": "webaim", "html": "<!DOCTYPE html><html lang=\"en\"><head>\n\t<meta charset=\"utf-8\">\n\t<title>Web Accessibility in Mind Conference: Register</title>\n\t<link rel=\"shortcut icon\" href=\"/media/favicon.ico\">\n\t<link rel=\"home\" href=\"/\">\n\t\n\t<link href=\"/media/styles.css?ver=2\" rel=\"stylesheet\" type=\"text/css\">\n\t<link href=\"https://fonts.googleapis.com/css?family=Roboto:100,400,700\" rel=\"stylesheet\" type=\"text/css\">\n\t\t<link href=\"https://fonts.googleapis.com/css?family=Open+Sans:300,400,400i,700\" rel=\"stylesheet\">\n\t\n\n<style type=\"text/css\">\nmain input[type=text], input[type=email], input[type=submit] {\n\tborder-radius:3px;\n\tborder:1px solid #bbb;\n\tpadding:3px;\n\tvertical-align: middle;\n\twidth:15em;\n\tfont: 100% 'Open Sans', 'Helvetica Neue', Helvetica, Arial, sans-serif;\n\tcolor: #333;\n\tborder-color:#000;\n}\ninput[type=submit] {\n\tbackground-color:#eee;\n}\n</style>\n</head>\n<body>\n<header>\n\t<div id=\"skiptocontent\"><a href=\"#maincontent\">skip to main content</a></div>\n\t\n\t<div id=\"icons\"><a href=\"https://webaim.org/\"><img src=\"/media/WebAIMIcon.svg\" alt=\"WebAIM - Web Accessibility In Mind\"></a> <a href=\"https://pope.tech/\"><img src=\"/media/popetechIcon.svg\" alt=\"Pope Tech\"></a></div>\n\n\t<nav>\n\t\t<ul>\n\t\t\t<li><a href=\"/\">Home</a></li>\n\t\t\t<li><a href=\"/speakers\">Speakers</a></li>\n\t\t\t<li><a href=\"/schedule\">Schedule</a></li>\n\t\t\t<li class=\"current\"><a href=\"/register\" id=\"registerlink\">REGISTER</a></li>\n\t\t</ul>\n\t</nav>\n\t\n\t<div id=\"banner\">\n\t\t<div id=\"bannertext\"><div id=\"bannerheader\">Web Accessibility in Mind Conference</div> \t\t<div id=\"subbanner\">in partnership with <img src=\"/media/popetechSmall.svg\" width=\"220\" alt=\"PopeTech\" height=\"50\"></div></div>\n\t\t<div id=\"bannerreg\"><a href=\"schedule\">VIEW SCHEDULE</a></div>\n\t</div>\n</header>\n\n<main id=\"maincontent\" cla