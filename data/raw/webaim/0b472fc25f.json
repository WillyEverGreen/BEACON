{"url": "https://webaim.org/resources/linkcontrastchecker/", "silo": "webaim", "html": "<!DOCTYPE html><html lang=\"en\"><head>\n\t<meta charset=\"utf-8\">\n\t<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n\t\t<title>WebAIM: Link Contrast Checker</title>\n\t<link rel=\"shortcut icon\" href=\"/media/favicon.ico\">\n\t<link rel=\"home\" href=\"/\">\n\t<link rel=\"search\" href=\"/search/\">\n\t<link rel=\"alternate\" href=\"https://webaim.org/blog/feed\" type=\"application/rss+xml\" title=\"WebAIM Blog\">\n\n\t<script async=\"\" src=\"https://www.googletagmanager.com/gtag/js?id=G-Y41PF8WV9X\"></script>\n\t<script>\n  \twindow.dataLayer = window.dataLayer || [];\n  \tfunction gtag(){dataLayer.push(arguments);}\n  \tgtag('js', new Date());\n  \tgtag('config', 'G-Y41PF8WV9X');\n\t</script>\n\t\n\t<link href=\"/styles/main.css\" rel=\"stylesheet\" type=\"text/css\">\n\t<link href=\"/styles/print.css\" rel=\"stylesheet\" type=\"text/css\" media=\"print\">\n\t<script src=\"/media/scripts/jquery.js\"></script>\n\t<script src=\"/media/scripts/main.js\"></script>\n\t<link href=\"https://fonts.googleapis.com/css?family=Roboto:400\" rel=\"stylesheet\" type=\"text/css\">\n\t<link href=\"https://fonts.googleapis.com/css?family=Kameron:400,700\" rel=\"stylesheet\" type=\"text/css\">\n\t<link href=\"/styles/documents.css?ver=2\" rel=\"stylesheet\">\n\t\t<link href=\"https://fonts.googleapis.com/css?family=Open+Sans:400,400i,700\" rel=\"stylesheet\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n\t\t<script src=\"linkcolor.js\"></script><script type=\"text/javascript\" async=\"\" src=\"https://googleads.g.doubleclick.net/pagead/viewthroughconversion/1069381703/?random=1774677429474&amp;cv=11&amp;fst=1774677429474&amp;bg=ffffff&amp;guid=ON&amp;async=1&amp;en=gtag.config&amp;gtm=45je63p1v899903185za200zd899903185xec&amp;gcd=13l3l3l3l1l1&amp;dma=0&amp;tag_exp=0~115938466~115938468~117384405~117484252&amp;u_w=1080&amp;u_h=600&amp;url=https%3A%2F%2Fwebaim.org%2Fresources%2Flinkcontrastchecker%2F&amp;frm=0&amp;tiba=WebAIM%3A%20Link%20Contrast%20Checker&amp;hn=www.googleadservices.com&amp;npa=0&amp;pscdl=noapi&amp;auid=1598495543.1774677300&amp;uaa=x86&amp;uab=64&amp;uafvl=Chromium%3B145.0.7632.6%7CNot%253AA-Brand%3B99.0.0.0&amp;uamb=0&amp;uam=&amp;uap=Linux&amp;uapv=&amp;uaw=0&amp;data=event%3Dgtag.config&amp;rfmt=3&amp;fmt=4\"></script>\n\t\t<script>\n\t\t\tfunction initialize() {\n\t\t\t\tf = '#000000', b = '#FFFFFF', l='#3333FF';\n\t\t\t\tupdate();\n\t\t\t}\n\t\t</script>\n\t\n<!--[if lt IE 9]>\n\t<script type=\"text/javascript\" src=\"http://html5shiv.googlecode.com/svn/trunk/html5.js\"></script>\n<![endif]-->\n</head>\n<body>\n\n\n<div id=\"headcontainer\" class=\"clearfix\" style=\"background-image: url(/media/banners/resources.jpg)\">\n<header>\n\t<div id=\"skiptocontent\"><a href=\"#maincontent\">skip to main content</a></div>\n\t\n\t<h2><a href=\"/\"><img src=\"/media/logo.png\" width=\"630\" height=\"167\" alt=\"WebAIM - Web Accessibility In Mind\"></a></h2>\n\n\t<nav>\n\t\t<h2 class=\"hidden\">Main Navigation</h2>\n\t\t<ul>\n\t\t\t<li><a href=\"/services/\">Services</a></li>\n\t\t\t<li><a href=\"/articles/\">Articles</a></li>\n\t\t\t<li class=\"current\"><a href=\"/resources/\">Resources</a></li>\n\t\t\t<li><a href=\"/projects/\">Projects</a></li>\n\t\t\t<li><a href=\"/community/\">Community</a></li>\n\t\t</ul>\n\t</nav>\n\t<div id=\"search\">\n\t\t<form method=\"get\" role=\"search\" action=\"/search/\" id=\"sitesearch\">\n\t\t\t<p class=\"search\"><span><label for=\"q\">Search:</label> <input type=\"text\" name=\"q\" id=\"q\"><input type=\"image\" src=\"/media/template/search.svg\" alt=\"Submit Search\"></span></p>\n\t\t</form>\n\t\t\n\t\t<p class=\"intro\"><a href=\"/intro\">Introduction to Web Accessibility</a></p>\n\t\t\n\t\t<p class=\"training\"><a href=\"/services/training\">WebAIM Training</a></p>\n\t</div>\n\n</header>\n</div>\n\n<main id=\"maincontainer\" class=\"clearfix\">\n\n<article id=\"maincontent\">\n\n<h1>Link Contrast Checker</h1>\n\n<p id=\"breadcrumbs\"><span class=\"hidden\">You are here: </span><a href=\"/\">Home</a> &gt; <a href=\"/resources/\">Resources</a> &gt; Link Contrast Checker</p>\n\n<style>\n\t#contrastForm {float:none}\n\t.linkResults {display:inline-block; vertical-align:middle}\n\t.linkResults p {padding-bottom:2px}\n</style>\n<div class=\"section\">\n\t<noscript>\n\t\t<p><strong>This tool requires Javascript.</strong></p>\n\t</noscript>\n\t<form id=\"contrastForm\">\n\t\t<fieldset>\n\t\t\t<legend>Link Color</legend>\n\t\t\t<p class=\"error\" id=\"lError\">Please enter a valid <a href=\"http://en.wikipedia.org/wiki/Web_colors#Hex_triplet\">hex triplet</a>, or use the color picker.</p>\n\t\t\t<label for=\"lHex\" class=\"hidden\">Hex</label>\n\t\t\t<input id=\"lHex\" type=\"text\" maxlength=\"7\" required=\"\">\n\t\t\t<label for=\"lPick\" class=\"hidden\">color picker</label>\n\t\t\t<input id=\"lPick\" type=\"color\">\n\t\t\t<div>\n\t\t\t\t<label for=\"lLightness\">Lightness</label>\n\t\t\t\t<input id=\"lLightness\" type=\"range\" min=\"0\" max=\"100\" step=\"1\">\n\t\t\t\t<div class=\"gradient\" style=\"background: linear-gradient(to right, rgb(0, 0, 0), rgb(0, 0, 255), rgb(255, 255, 255));\"></div>\n\t\t\t</div>\n\t\t</fieldset>\n\t\t<fieldset>\n\t\t\t<legend>Body Text Color</legend>\n\t\t\t<p class=\"error\" id=\"fError\">Please enter a valid <a href=\"http://en.wikipedia.org/wiki/Web_colors#Hex_triplet\">hex triplet</a>, or use the color picker.</p>\n\t\t\t<label for=\"fHex\" class=\"hidden\">Hex</label>\n\t\t\t<input id=\"fHex\" type=\"text\" maxlength=\"7\" required=\"\">\n\t\t\t<label for=\"fPick\" class=\"hidden\">color picker</label>\n\t\t\t<input id=\"fPick\" type=\"color\">\n\t\t\t<div>\n\t\t\t\t<label for=\"fLightness\">Lightness</label>\n\t\t\t\t<input id=\"fLightness\" type=\"range\" min=\"0\" max=\"100\" step=\"1\">\n\t\t\t\t<div class=\"gradient\" style=\"background: linear-gradient(to right, rgb(0, 0, 0), rgb(128, 128, 128), rgb(255, 255, 255));\"></div>\n\t\t\t</div>\n\t\t</fieldset>\n\t\t<fieldset>\n\t\t\t<legend>Background Color</legend>\n\t\t\t<p class=\"error\" id=\"bError\">Please enter a valid <a href=\"http://en.wikipedia.org/wiki/Web_colors#Hex_triplet\">hex triplet</a>, or use the color picker.</p>\n\t\t\t<label for=\"bHex\" class=\"hidden\">Hex</label>\n\t\t\t<input id=\"bHex\" type=\"text\" maxlength=\"7\" required=\"\">\n\t\t\t<label for=\"bPick\" class=\"hidden\">color picker</label>\n\t\t\t<input id=\"bPick\" type=\"color\">\n\t\t\t<div>\n\t\t\t\t<label for=\"bLightness\">Lightness</label>\n\t\t\t\t<input id=\"bLightness\" type=\"range\" min=\"0\" max=\"100\" step=\"1\">\n\t\t\t\t<div class=\"gradient\" style=\"background: linear-gradient(to right, rgb(0, 0, 0), rgb(128, 128, 128), rgb(255, 255, 255));\"></div>\n\t\t\t</div>\n\t\t</fieldset>\n\t</form>\n\t\n\t<div id=\"normal\" style=\"color: rgb(0, 0, 0); background-color: rgb(255, 255, 255);\">The five <a href=\"/\" id=\"samplelink\" style=\"color: rgb(51, 51, 255);\">boxing wizards</a> jump quickly.</div>\n\t\n\t<div id=\"linkTextRatioContainer\" class=\"pass\">\n\t\t<div class=\"linkResults\">\n\t\t\t<h2>Link to Body Text</h2>\n\t\t\t<p>WCAG A: <span id=\"linkTextA\" class=\"pass\">Pass</span></p>\n\t\t</div>\n\t\t<span id=\"linkTextRatio\" aria-live=\"polite\" aria-atomic=\"false\"><b>3.05</b>:1</span>\n\t</div>\n\t<div id=\"linkBackRatioContainer\" class=\"pass\">\n\t\t<div class=\"linkResults\">\n\t\t\t<h2>Link to Background</h2>\n\t\t\t<p>WCAG AA: <span id=\"linkBackAA\" class=\"pass\">Pass</span></p>\n\t\t</div>\n\t\t<span id=\"linkBackRatio\" aria-live=\"polite\" aria-atomic=\"false\"><b>6.86</b>:1</span>\n\t</div>\n\t<div id=\"textBackRatioContainer\" class=\"pass\">\n\t\t<div class=\"linkResults\">\n\t\t\t<h2>Body Text to Background</h2>\n\t\t\t<p>WCAG AA: <span id=\"textBackAA\" class=\"pass\">Pass</span></p>\n\t\t</div>\n\t\t<span id=\"textBackRatio\" aria-live=\"polite\" aria-atomic=\"false\"><b>21</b>:1</span>\n\t</div>\n\t<p><a id=\"permalink\" class=\"permalink\" href=\"./?fcolor=000000&amp;bcolor=FFFFFF&amp;lcolor=3333FF\">permalink</a></p>\n\n<div class=\"callout\">\n\t<div class=\"title\">WebAIM Accessibility Testing Services</div>\n\t<p>The experts at WebAIM can audit your web site and provide a detailed report to help you remediate accessibility and WCAG compliance issues.</p>\n\t<p class=\"calloutlink\"><a href=\"/services/evaluation\">Learn more about WebAIM Evaluation Services</a>\n</p></div>\n\n\t<h2>Explanation</h2>\n\t\n\t<p>For usability and accessibility, links should be underlined by default. Otherwise, <a href=\"/articles/contrast/#only\">link text must have at least 3:1 contrast with surrounding body text</a>, and must present a non-color indicator (typically underline) on mouse hover and keyboard focus.</p>\n\t<p>In addition, both links and body text must have at least 4.5:1 contrast with the background (3:1 for large text) to meet WCAG 2 Level AA.</p>\n\t<p>Enter link, body text, and background colors in RGB hexadecimal format (e.g., #FD3 or #F7DA39) or use the color pickers. The Lightness sliders can be used to adjust the selected color. Feedback will be presented for all three required contrast calculations.</p>\n\t<p>To check the contrast of large text, or to check against Level AAA contrast requirements, use <a href=\"/resources/contrastchecker/?fcolor=000000&amp;bcolor=FFFFFF\">our standard contrast checker</a>.</p>\n\t<div class=\"note\">\n\t\t<div class=\"title\">New!</div>\n\t\t<p>This tool also functions as a basic API. Simply append <code>&amp;api</code> to any permalink to get a JSON object with the contrast ratios. For example: <a class=\"apilink\" href=\"./?fcolor=000000&amp;bcolor=FFFFFF&amp;lcolor=3333FF&amp;api\">https://webaim.org/resources/contrastchecker/?fcolor=000000&amp;bcolor=FFFFFF&amp;lcolor=3333FF&amp;api</a>.</p>\n\t</div>\t\n</div>\n</article>\n<!--\n\t-->\n<aside id=\"articlemeta\">\n\n\t\n\t\t\n\t\t\t\t<div id=\"related\">\n\t\t\t<h2>Related Resources</h2>\n\t\t\t<ul>\n\t\t\t<li><a href=\"/articles/contrast/\">Understanding WCAG 2 Contrast and Color Requirements</a></li>\n<li><a href=\"/resources/evalquickref/\">Quick Reference: Testing Web Content for Accessibility</a></li>\n<li><a href=\"/resources/designers/\">Web Accessibility for Designers</a></li>\n<li><a href=\"/resources/contrastchecker/?fcolor=000000&amp;bcolor=FFFFFF\">Contrast Checker</a></li>\n\t\t\t</ul>\n\t\t</div>\n\t\t\n\t\t\n</aside>\n</main>\n\n<footer>\n\t<div id=\"footerresources\">\n\t\t<div class=\"footerblock\">\n\t\t\t<h2 id=\"copyright\">\u00a92026 WebAIM</h2>\n\t\t\t<p id=\"contact\">\t\t\tUtah State University<br>\n\t\t\t6807 Old Main Hill<br>\n\t\t\tLogan, UT 84322-6807<br>\n\t\t\t<a class=\"phone\" href=\"tel:4357977024\">435.797.7024</a></p>\n\t\t\n\t\t<div id=\"checkpage\">\n\t\t\t<h2>Check Your Accessibility</h2>\n\t\t\t<form action=\"https://wave.webaim.org/report\" novalidate=\"\">\n\t\t\t\t<label for=\"waveurl\">Web site address:</label>\n\t\t\t\t<input type=\"url\" id=\"waveurl\" name=\"url\" title=\"Web site address\">\n\t\t\t\t<input type=\"submit\" value=\"WAVE\">\n\t\t\t</form>\n\t\t</div>\n\t\t</div>\n\t\t<div class=\"footerblock\">\n\t\t\t<h2 id=\"blog\">From the Blog</h2>\n\t\t\t<ul><li><a href=\"/blog/a-new-path/\">A New Path for Digital Accessibility?</a></li><li><a href=\"/blog/2026-predictions/\">2026 Predictions: The Next Big Shifts in Web Accessibility</a></li><li><a href=\"/blog/word-and-powerpoint-alt-text-roundup/\">Word and PowerPoint Alt Text Roundup</a></li><li><a href=\"/blog/accessibility-by-design/\">Accessibility by Design: Preparing K\u201312 Schools for What\u2019s Next</a></li></ul>\t\t</div>\n\t\t<div class=\"footerblock\">\n\t\t\t<h2 id=\"popular\">Popular Resources</h2>\n\t\t\t<ul>\n\t\t\t\t<li><a href=\"/services/training/\">WebAIM Training</a></li>\n\t\t\t\t<li><a href=\"/standards/wcag/checklist\">WCAG 2 Checklist</a></li>\n\t\t\t\t<li><a href=\"/newsletter\">WebAIM Monthly Newsletter</a></li>\n\t\t\t\t<li><a href=\"/resources/contrastchecker\">Color Contrast Checker</a></li>\n\t\t\t\t<li><a href=\"/resources/designers/\">Web Accessibility for Designers</a></li>\n\t\t\t\t<li><a href=\"http://wave.webaim.org/\">WAVE Web Accessibility Evaluation Tool</a></li>\n\t\t\t</ul>\n\t\t</div>\n\t\t\n\t\t<div id=\"footerlinks\">\n\t\t\t<ul>\n\t\t\t\t<li><a id=\"footercontact\" href=\"/contact\">Contact</a></li>\n\t\t\t\t<li><a id=\"footerabout\" href=\"/about\">About</a></li>\n\t\t\t\t<li><a id=\"footerrss\" href=\"/community/rss\">RSS Feeds</a></li>\n\t\t\t\t<li><a id=\"footerli\" href=\"https://www.linkedin.com/company/webaim/\">LinkedIn</a></li>\n\t\t\t\t<li><a id=\"footercopyright\" href=\"/copyright\">Copyright &amp; Terms of Use</a></li>\n\t\t\t</ul>\n\t\t</div>\n\t\t\n\t\t<div class=\"clear\"></div>\n\t</div>\n\n</footer>\n\n\n<flying-focus id=\"flying-focus\" style=\"transition-duration: 0.1s;\"></flying-focus></body></html>", "links": [{"href": "https://webaim.org/resources/linkcontrastchecker/", "text": "skip to main content", "title": "", "base_domain": "webaim.org", "head_data": null, "head_extraction_status": null, "head_extraction_error": null, "intrinsic_score": 0.0, "contextual_score": null, "total_score": null}, {"href": "https://webaim.org/", "text": "", "title": "", "base_domain": "webaim.org", "head_data": null, "head_extraction_status": null, "head_extraction_error": null, "intrinsic_score": 0.0, "contextual_score": null, "total_score": null}, {"href": "https://webaim.org/services/", "text": "Services", "title": "", "base_domain": "webaim.org", "head_data": null, "head_extraction_status": null, "head_extraction_error": null, "intrinsic_score": 0.0, "contextual_score": null, "total_score": null}, {"href": "https://webaim.org/articles/", "text": "Articles", "title": "", "base_domain": "webaim.org", "head_data": null, "head_extraction_status": null, "head_extraction_error": null, "intrinsic_score": 0.0, "contextu