{"url": "https://webaim.org/projects/", "silo": "webaim", "html": "<!DOCTYPE html><html lang=\"en\"><head>\n\t<meta charset=\"utf-8\">\n\t<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n\t\t<title>WebAIM: Projects</title>\n\t<link rel=\"shortcut icon\" href=\"/media/favicon.ico\">\n\t<link rel=\"home\" href=\"/\">\n\t<link rel=\"search\" href=\"/search/\">\n\t<link rel=\"alternate\" href=\"https://webaim.org/blog/feed\" type=\"application/rss+xml\" title=\"WebAIM Blog\">\n\n\t<script async=\"\" src=\"https://www.googletagmanager.com/gtag/js?id=G-Y41PF8WV9X\"></script>\n\t<script>\n  \twindow.dataLayer = window.dataLayer || [];\n  \tfunction gtag(){dataLayer.push(arguments);}\n  \tgtag('js', new Date());\n  \tgtag('config', 'G-Y41PF8WV9X');\n\t</script>\n\t\n\t<link href=\"/styles/main.css\" rel=\"stylesheet\" type=\"text/css\">\n\t<link href=\"/styles/print.css\" rel=\"stylesheet\" type=\"text/css\" media=\"print\">\n\t<script src=\"/media/scripts/jquery.js\"></script>\n\t<script src=\"/media/scripts/main.js\"></script>\n\t<link href=\"https://fonts.googleapis.com/css?family=Roboto:400\" rel=\"stylesheet\" type=\"text/css\">\n\t<link href=\"https://fonts.googleapis.com/css?family=Kameron:400,700\" rel=\"stylesheet\" type=\"text/css\">\n\t<link href=\"/styles/documents.css?ver=2\" rel=\"stylesheet\">\n\t\t<link href=\"https://fonts.googleapis.com/css?family=Open+Sans:400,400i,700\" rel=\"stylesheet\">\n\n<!--[if lt IE 9]>\n\t<script type=\"text/javascript\" src=\"http://html5shiv.googlecode.com/svn/trunk/html5.js\"></script>\n<![endif]-->\n<script type=\"text/javascript\" async=\"\" src=\"https://googleads.g.doubleclick.net/pagead/viewthroughconversion/1069381703/?random=1774685909993&amp;cv=11&amp;fst=1774685909993&amp;bg=ffffff&amp;guid=ON&amp;async=1&amp;en=gtag.config&amp;gtm=45je63q0h2v899903185za200zd899903185xec&amp;gcd=13l3l3l3l1l1&amp;dma=0&amp;tag_exp=0~115938466~115938469~116133314~117384406~117484252&amp;u_w=1080&amp;u_h=600&amp;url=https%3A%2F%2Fwebaim.org%2Fprojects%2F&amp;frm=0&amp;tiba=WebAIM%3A%20Projects&amp;hn=www.googleadservices.com&amp;npa=0&amp;pscdl=noapi&amp;auid=301195456.1774685902&amp;uaa=x86&amp;uab=64&amp;uafvl=Chromium%3B145.0.7632.6%7CNot%253AA-Brand%3B99.0.0.0&amp;uamb=0&amp;uam=&amp;uap=Linux&amp;uapv=&amp;uaw=0&amp;data=event%3Dgtag.config&amp;rfmt=3&amp;fmt=4\"></script></head>\n<body>\n\n\n<div id=\"headcontainer\" class=\"clearfix\" style=\"background-image: url(/media/banners/projects.jpg)\">\n<header>\n\t<div id=\"skiptocontent\"><a href=\"#maincontent\">skip to main content</a></div>\n\t\n\t<h2><a href=\"/\"><img src=\"/media/logo.png\" width=\"630\" height=\"167\" alt=\"WebAIM - Web Accessibility In Mind\"></a></h2>\n\n\t<nav>\n\t\t<h2 class=\"hidden\">Main Navigation</h2>\n\t\t<ul>\n\t\t\t<li><a href=\"/services/\">Services</a></li>\n\t\t\t<li><a href=\"/articles/\">Articles</a></li>\n\t\t\t<li><a href=\"/resources/\">Resources</a></li>\n\t\t\t<li class=\"current\"><a href=\"/projects/\">Projects</a></li>\n\t\t\t<li><a href=\"/community/\">Community</a></li>\n\t\t</ul>\n\t</nav>\n\t<div id=\"search\">\n\t\t<form method=\"get\" role=\"search\" action=\"/search/\" id=\"sitesearch\">\n\t\t\t<p class=\"search\"><span><label for=\"q\">Search:</label> <input type=\"text\" name=\"q\" id=\"q\"><input type=\"image\" src=\"/media/template/search.svg\" alt=\"Submit Search\"></span></p>\n\t\t</form>\n\t\t\n\t\t<p class=\"intro\"><a href=\"/intro\">Introduction to Web Accessibility</a></p>\n\t\t\n\t\t<p class=\"training\"><a href=\"/services/training\">WebAIM Training</a></p>\n\t</div>\n\n</header>\n</div>\n\n<main id=\"maincontainer\" class=\"clearfix\">\n\n<article id=\"maincontent\">\n\n<h1>Projects</h1>\n\n<p id=\"breadcrumbs\"><span class=\"hidden\">You are here: </span><a href=\"/\">Home</a> &gt; WebAIM Projects</p>\n\n\n<div class=\"section\">\n<p>WebAIM is actively involved in various projects to improve the accessibility of the web.</p>\n</div>\n\n<div class=\"note\">\n\t<div class=\"title\">Supported by BrowserStack</div>\n\t<p>WebAIM research is funded in part by a donation from <a href=\"https://www.browserstack.com/a11y-testing-webaim\" style=\"background-color:#F3F3F3 !important; border:none !important\"><img src=\"media/browserstack-logo.png\" alt=\"BrowserStack\" style=\"width:300px;\" width=\"600\" height=\"140\"></a></p>\n</div>\n\n<div class=\"section\">\n<h2>Current Projects</h2>\n<ul>\n\t<li>Global Digital Accessibility Salary Survey\n\t\t<ul>\n\t\t\t<li><a href=\"salary2/\">Survey #2 - January 2026</a></li>\n\t\t\t<li><a href=\"salary/\">Survey #1 - January 2025</a></li>\n\t\t</ul>\n\t</li>\n<li>Screen Reader User Surveys\n\t<ul>\n\t\t<li><a href=\"screenreadersurvey10/\">Survey #10</a></li>\n\t\t<li><a href=\"screenreadersurvey9/\">Survey #9</a></li>\n\t\t<li><a href=\"screenreadersurvey8/\">Survey #8</a></li>\n\t\t<li><a href=\"screenreadersurvey7/\">Survey #7</a></li>\n\t\t<li><a href=\"screenreadersurvey6/\">Survey #6</a></li>\n\t\t<li><a href=\"screenreadersurvey5/\">Survey #5</a></li>\n\t\t<li><a href=\"screenreadersurvey4/\">Survey #4</a></li>\n\t\t<li><a href=\"screenreadersurvey3/\">Survey #3</a></li>\n\t\t<li><a href=\"screenreadersurvey2/\">Survey #2</a></li>\n\t\t<li><a href=\"screenreadersurvey/\">Survey #1</a></li>\n\t</ul>\n</li>\n<li><a href=\"million\">The WebAIM Million: An accessibility analysis of the top 1,000,000 home pages</a></li>\n<li>Survey of Web Accessibility Practitioners\n\t<ul>\n\t\t<li><a href=\"practitionersurvey3/\">Survey #3</a></li>\n\t\t<li><a href=\"practitionersurvey2/\">Survey #2</a></li>\n\t\t<li><a href=\"practitionersurvey/\">Survey #1</a></li>\n\t</ul>\n</li>\n<li><a href=\"uceddlongitudinal\">Four Years of Accessibility Data in Prominent US Networks: An analysis of UCEDD, Institution, and US state/territory accessibility</a>\n\n</li><li>Survey of Users with Low Vision\n\t<ul>\n\t\t<li><a href=\"lowvisionsurvey2/\">Survey #2</a></li>\n\t\t<li><a href=\"lowvisionsurvey\">Survey #1</a></li>\n\t</ul>\n</li>\n\n\n\n<li><a href=\"motordisabilitysurvey/\">Survey of Users with Motor Disabilities</a></li>\n<li><a href=\"http://wave.webaim.org/\">WAVE development</a></li>\n<li>NCDAE/WebAIM Web Accessibility in Accreditation Initiative\n\t<ul>\n\t<li>The <a href=\"http://ncdae.org/\">National Center on Disability and Access to Education</a> (NCDAE) and WebAIM have received funding to explore web accessibility in the education accreditation arena. The project is  a 3-year effort supported by the <a href=\"http://www.ed.gov/about/offices/list/ope/fipse/index.html\">Fund for the Improvement of Postsecondary  Education</a> (FIPSE) under their highly competitive <a href=\"http://www.ed.gov/programs/fipsecomp/index.html\">Comprehensive Program</a>. Partners include Michigan Community College Virtual Learning Collaborative (MCCVLA); Southern Association of Colleges and Schools \u2013 Commission on Colleges (SACSCOC); Southern Regional Education Board (SREB); Western Interstate Commission for Higher Education (WICHE).</li>\n\t</ul>\n</li>\n</ul>\n</div>\n\n<div class=\"section\">\n<h2>Past Projects</h2>\n\n<ul>\n\t<li>Steppingstones Project on Web Accessibility and Cognitive Disabilities in Education\n\t\t<ul>\n\t\t\t<li><a href=\"steppingstones/litreviewsummary\">Cognitive and Learning Disabilities Literature Review</a></li>\n\t\t\t<li><a href=\"steppingstones/cognitiveresearch\">Overview of Steppingstones Cognitive Research</a></li>\n\t\t</ul>\n\t</li>\n\t<li><abbr title=\"Web Standards Project\">WASP</abbr> Accessibility Task Force</li>\n\t<li>CaptionCaster development</li>\n\t<li><abbr title=\"National Clearinghouse of Rehabilitation Training Materials\">NCRTM</abbr> &amp; Moodle Accessibility Project</li>\n\t<li>XUL Accessibility</li>\n\t<li>Brigham and Women's Hospital Kessler Library</li>\n\t<li>YES Project</li>\n\t<li>PowerPay</li>\n\t<li>Accent Tool Development and Whitepaper</li>\n\t<li>WAVE 3.0 Development</li>\n\t<li>IBM Global Campus:  Advanced Web Accessibility Education Course</li>\n\t<li>WebAIM: Subject Matter Experts to University of Maryland University College grant</li>\n\t<li>National Institute for Keeping Web Accessibility in Mind in K-12 Education: Project WebAIM</li>\n\t<li>Accessibility to Learning Environments: Learning Anytime, Anywhere, for Anyone</li>\n</ul>\n</div>\n\n</article>\n<!--\n\t-->\n<aside id=\"articlemeta\">\n\n\t\n\t\t\n\t\t\t\t<div id=\"related\">\n\t\t\t<h2>Related Resources</h2>\n\t\t\t<ul>\n\t\t\t<li><a href=\"http://wave.webaim.org/\">WAVE</a></li>\n<li><a href=\"/about/\">About WebAIM</a></li>\n<li><a href=\"/contact/\">Contact WebAIM</a></li>\n\t\t\t</ul>\n\t\t</div>\n\t\t\n\t\t\n</aside>\n</main>\n\n<footer>\n\t<div id=\"footerresources\">\n\t\t<div class=\"footerblock\">\n\t\t\t<h2 id=\"copyright\">\u00a92026 WebAIM</h2>\n\t\t\t<p id=\"contact\">\t\t\tUtah State University<br>\n\t\t\t6807 Old Main Hill<br>\n\t\t\tLogan, UT 84322-6807<br>\n\t\t\t<a class=\"phone\" href=\"tel:4357977024\">435.797.7024</a></p>\n\t\t\n\t\t<div id=\"checkpage\">\n\t\t\t<h2>Check Your Accessibility</h2>\n\t\t\t<form action=\"https://wave.webaim.org/report\" novalidate=\"\">\n\t\t\t\t<label for=\"waveurl\">Web site address:</label>\n\t\t\t\t<input type=\"url\" id=\"waveurl\" name=\"url\" title=\"Web site address\">\n\t\t\t\t<input type=\"submit\" value=\"WAVE\">\n\t\t\t</form>\n\t\t</div>\n\t\t</div>\n\t\t<div class=\"footerblock\">\n\t\t\t<h2 id=\"blog\">From the Blog</h2>\n\t\t\t<ul><li><a href=\"/blog/a-new-path/\">A New Path for Digital Accessibility?</a></li><li><a href=\"/blog/2026-predictions/\">2026 Predictions: The Next Big Shifts in Web Accessibility</a></li><li><a href=\"/blog/word-and-powerpoint-alt-text-roundup/\">Word and PowerPoint Alt Text Roundup</a></li><li><a href=\"/blog/accessibility-by-design/\">Accessibility by Design: Preparing K\u201312 Schools for What\u2019s Next</a></li></ul>\t\t</div>\n\t\t<div class=\"footerblock\">\n\t\t\t<h2 id=\"popular\">Popular Resources</h2>\n\t\t\t<ul>\n\t\t\t\t<li><a href=\"/services/training/\">WebAIM Training</a></li>\n\t\t\t\t<li><a href=\"/standards/wcag/checklist\">WCAG 2 Checklist</a></li>\n\t\t\t\t<li><a href=\"/newsletter\">WebAIM Monthly Newsletter</a></li>\n\t\t\t\t<li><a href=\"/resources/contrastchecker\">Color Contrast Checker</a></li>\n\t\t\t\t<li><a href=\"/resources/designers/\">Web Accessibility for Designers</a></li>\n\t\t\t\t<li><a href=\"http://wave.webaim.org/\">WAVE Web Accessibility Evaluation Tool</a></li>\n\t\t\t</ul>\n\t\t</div>\n\t\t\n\t\t<div id=\"footerlinks\">\n\t\t\t<ul>\n\t\t\t\t<li><a id=\"footercontact\" href=\"/contact\">Contact</a></li>\n\t\t\t\t<li><a id=\"footerabout\" href=\"/about\">About</a></li>\n\t\t\t\t<li><a id=\"footerrss\" href=\"/community/rss\">RSS Feeds</a></li>\n\t\t\t\t<li><a id=\"footerli\" href=\"https://www.linkedin.com/company/webaim/\">LinkedIn</a></li>\n\t\t\t\t<li><a id=\"footercopyright\" href=\"/copyright\">Copyright &amp; Terms of Use</a></li>\n\t\t\t</ul>\n\t\t</div>\n\t\t\n\t\t<div class=\"clear\"></div>\n\t</div>\n\n</footer>\n\n\n<flying-focus id=\"flying-focus\" style=\"transition-duration: 0.1s;\"></flying-focus></body></html>", "links": [{"href": "https://webaim.org/projects/", "text": "skip to main content", "title": "", "base_domain": "webaim.org", "head_data": null, "head_extraction_status": null, "head_extraction_error": null, "intrinsic_score": 0.0, "contextual_score": null, "total_score": null}, {"href": "https://webaim.org/", "text": "", "title": "", "base_domain": "webaim.org", "head_data": null, "head_extraction_status": null, "head_extraction_error": null, "intrinsic_score": 0.0, "contextual_score": null, "total_score": null}, {"href": "https://webaim.org/services/", "text": "Services", "title": "", "base_domain": "webaim.org", "head_data": null, "head_extraction_status": null, "head_extraction_error": null, "intrinsic_score": 0.0, "contextual_score": null, "total_score": null}, {"href": "https://webaim.org/arti