{"url": "https://webaim.org/techniques/disclosures/disclosure.htm", "silo": "webaim", "html": "<!DOCTYPE html><html lang=\"en\"><head>\n<meta charset=\"utf-8\">\n<title>ARIA Disclosure</title>\n<link href=\"/styles/examplestyles.css\" rel=\"stylesheet\">\n\n<style>\n#trigger {\n\tborder:none;\n}\n\n#trigger[aria-expanded=\"false\"]::before {\n    content: '\\25b8\\0020'/'';\n}\n\n#trigger[aria-expanded=\"true\"]::before {\n    content: '\\25bE\\0020'/'';\n}\n\n</style>\n\n</head>\n\n<body>\n<h1>ARIA Disclosure</h1>\n\n<p>This example demonstrates how ARIA disclosures work.</p>\n\n<p><button id=\"trigger\" aria-expanded=\"false\">View Details</button>\n\n</p><p id=\"content\" hidden=\"\">Hey there! I am the details!</p>\n\n<script>\nconst content=document.getElementById(\"content\");\ncontent.hidden=true; // Hide the contents by default\n\nconst trigger=document.getElementById(\"trigger\");\ntrigger.addEventListener(\"click\", (event) => {\n\tconst isHidden = content.hidden = !content.hidden; // Toggle content hidden state\n\ttrigger.setAttribute('aria-expanded', !isHidden); // Set aria-expanded to align with visibility\n});\n\n</script>\n\n\n\n</body></html>", "links": []}