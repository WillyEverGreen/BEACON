{"url": "https://conference.webaim.org/schedule", "silo": "webaim", "html": "<!DOCTYPE html><html lang=\"en\"><head>\n\t<meta charset=\"utf-8\">\n\t<title>Web Accessibility in Mind Conference: Schedule</title>\n\t<link rel=\"shortcut icon\" href=\"/media/favicon.ico\">\n\t<link rel=\"home\" href=\"/\">\n\t\n\t<link href=\"/media/styles.css?ver=2\" rel=\"stylesheet\" type=\"text/css\">\n\t<link href=\"https://fonts.googleapis.com/css?family=Roboto:100,400,700\" rel=\"stylesheet\" type=\"text/css\">\n\t\t<link href=\"https://fonts.googleapis.com/css?family=Open+Sans:300,400,400i,700\" rel=\"stylesheet\">\n\t\n</head>\n<body>\n<header>\n\t<div id=\"skiptocontent\"><a href=\"#maincontent\">skip to main content</a></div>\n\t\n\t<div id=\"icons\"><a href=\"https://webaim.org/\"><img src=\"/media/WebAIMIcon.svg\" alt=\"WebAIM - Web Accessibility In Mind\"></a> <a href=\"https://pope.tech/\"><img src=\"/media/popetechIcon.svg\" alt=\"Pope Tech\"></a></div>\n\n\t<nav>\n\t\t<ul>\n\t\t\t<li><a href=\"/\">Home</a></li>\n\t\t\t<li><a href=\"/speakers\">Speakers</a></li>\n\t\t\t<li class=\"current\"><a href=\"/schedule\">Schedule</a></li>\n\t\t\t<li><a href=\"/register\" id=\"registerlink\">REGISTER</a></li>\n\t\t</ul>\n\t</nav>\n\t\n\t<div id=\"banner\">\n\t\t<div id=\"bannertext\"><div id=\"bannerheader\">Web Accessibility in Mind Conference</div> \t\t<div id=\"subbanner\">in partnership with <img src=\"/media/popetechSmall.svg\" width=\"220\" alt=\"PopeTech\" height=\"50\"></div></div>\n\t\t<div id=\"bannerreg\"><a href=\"schedule\">VIEW SCHEDULE</a></div>\n\t</div>\n</header>\n\n<main id=\"maincontent\" class=\"clearfix\">\n\n<div class=\"content\">\n\t<h1>Schedule</h1>\n\t\n\t<p>The Web Accessibility in Mind Conference was held online via Zoom <strong>September 16\u201317, 2025</strong>.</p>\n\n\n\t<p><a href=\"https://www.youtube.com/playlist?list=PLrp9fl7pgGCFIwYSXdZiyppj2l0fdvcb_\">2025 conference video recordings</a> are available on YouTube.</p>\n\n<div id=\"sessioncontainer\">\n\t\n\t<h2 id=\"session1\">Tuesday, September 16 at 9:15 PM India Standard Time</h2>\n\t<h3><img src=\"/media/speakers/mark.jpg\" alt=\"\">Mark Steadman</h3>\n\t<p class=\"sessiontitle\">A Tangled Web of ARIA</p>\n\t<p class=\"join\"><a href=\"https://www.youtube.com/watch?v=5Mbjj3SX1Ck\">Watch this session recording</a></p>\n\t\n\t<h2 id=\"session2\">Tuesday, September 16 at 10:30 PM India Standard Time</h2>\n\t<h3><img src=\"/media/speakers/annie.jpg\" alt=\"\">Annie Ross</h3>\n\t<p class=\"sessiontitle\">Understanding Burnout in Accessibility Work</p>\n\t<p class=\"join\"><a href=\"https://www.youtube.com/watch?v=ppkuweHxUHc\">Watch this session recording</a></p>\n\t\n\t<h2 id=\"session3\">Tuesday, September 16 at 11:45 PM India Standard Time</h2>\n\t<h3><img src=\"/media/speakers/uw.jpg\" alt=\"\">Terrill Thompson, Gaby de Jongh, and Alaina Foust</h3>\n\t<p class=\"sessiontitle\">Creating Accessible Documents and Slides: Microsoft, Google, and Canva</p>\n\t<p class=\"join\"><a href=\"https://www.youtube.com/watch?v=pQZQ0ehzgB0\">Watch this session recording</a></p>\n\t\n\t<h2 id=\"session4\">Wednesday, September 17 at 1:00 AM India Standard Time</h2>\n\t<h3><img src=\"/media/speakers/sam.jpg\" alt=\"\">Sam Hobson</h3>\n\t<p class=\"sessiontitle\">Actually Shifting Left: Technical Accessibility for Designers</p>\n\t<p class=\"join\"><a href=\"https://www.youtube.com/watch?v=LOW8mlNorPY\">Watch this session recording</a></p>\n\t\n\t<h2 id=\"session5\">Wednesday, September 17 at 9:15 PM India Standard Time</h2>\n\t<h3><img src=\"/media/speakers/ted.jpg\" alt=\"\">Ted Drake and Marco Salsiccia</h3>\n\t<p class=\"sessiontitle\">AI and alt text</p>\n\t<p class=\"join\"><a href=\"https://www.youtube.com/watch?v=x9J3LIgq8Q4\">Watch this session recording</a></p>\n\t\n\t<h2 id=\"session6\">Wednesday, September 17 at 10:30 PM India Standard Time</h2>\n\t<h3><img src=\"/media/speakers/sarah.jpg\" alt=\"\">Sarah Horton</h3>\n\t<p class=\"sessiontitle\">Never Delegate Understanding: Foundations of Digital Accessibility</p>\n\t<p class=\"join\"><a href=\"https://www.youtube.com/watch?v=YcE471Dku4o\">Watch this session recording</a></p>\n\t\n\t<h2 id=\"session7\">Wednesday, September 17 at 11:45 PM India Standard Time</h2>\n\t<h3><img src=\"/media/speakers/kavana.jpg\" alt=\"\">Kavana Ramesh</h3>\n\t<p class=\"sessiontitle\">Practicing Accessibility Research with Confidence</p>\n\t<p class=\"join\"><a href=\"https://www.youtube.com/watch?v=Iy-lQjkUlsw\">Watch this session recording</a></p>\n\t\n\t<h2 id=\"session8\">Thursday, September 18 at 1:00 AM India Standard Time</h2>\n\t<h3><img src=\"/media/speakers/juanita.jpg\" alt=\"\">Jaunita Flessas</h3>\n\t<p class=\"sessiontitle\">Win with Metrics: How to Track and Show the Value of Your Program</p>\n\t<p class=\"join\"><a href=\"https://www.youtube.com/watch?v=lKft6dIG5qM\">Watch this session recording</a></p>\n\t\n</div>\n\n</div>\n\n<div id=\"cta\">\n\t<p>Join us for two days of web accessibility presentations!</p>\n\t<p><a href=\"/register\">Register Now</a></p>\n</div>\n\n<script>\n\nvar eventstart = new Date(Date.UTC(2025, 8, 16, 16, 0, 0));\n\nconst timezone = Intl.DateTimeFormat().resolvedOptions().timeZone;\n\nconst locale = Intl.NumberFormat().resolvedOptions().locale;\n\nconst options = { weekday: 'long', month: 'long', day: 'numeric', timeZone: timezone, hour: 'numeric', minute: 'numeric', timeZoneName: 'longGeneric'};\n\nsetTimes('session1',0,15);\nsetTimes('session2',1,30);\nsetTimes('session3',1,45);\nsetTimes('session4',2,0);\n\nvar eventstart = new Date(Date.UTC(2025, 8, 17, 16, 15, 0));\n\nsetTimes('session5',0,15);\nsetTimes('session6',1,30);\nsetTimes('session7',1,45);\nsetTimes('session8',2,0);\n\nfunction setTimes(elementid,houroffset,minoffset) {\n\teventstart.setHours(eventstart.getHours() + houroffset,minoffset);\n\tdocument.getElementById(elementid).innerHTML=(eventstart.toLocaleString(locale , options));\n}\n\n\n</script>\n\n</main>\n\n<footer>\n\t<div id=\"footerresources\">\n\t\t<div><a href=\"https://webaim.org/\"><img src=\"media/WebAIM-logo-white.svg\" alt=\"WebAIM - web accessibility in mind\" width=\"350\"></a></div>\n\t\t<div><a href=\"https://pope.tech/\"><img src=\"media/popetechSmall.svg\" alt=\"Pope Tech\" width=\"220\" height=\"50\"></a></div>\n\t</div>\n\t<div id=\"footerlinks\">\n\t\t<ul>\n\t\t\t<li><a href=\"/about\">About</a></li>\n\t\t\t<li><a href=\"/coc\">Code of Conduct</a></li>\n\t\t\t<li><a href=\"https://webaim.org/contact\">Contact Us</a></li>\n\t\t</ul>\n\t</div>\n\t<div id=\"copyright\">WebAIM is a non-profit web accessibility consultancy based at Utah State University.<br>\u00a9 2024 - WebAIM</div>\n</footer>\n\n\n</body></html>", "links": [{"href": "https://conference.webaim.org/schedule", "text": "skip to main content", "title": "", "base_domain": "webaim.org", "head_data": null, "head_extraction_status": null, "head_extraction_error": null, "intrinsic_score": 0.0, "contextual_score": null, "total_score": null}, {"href": "https://webaim.org/", "text": "", "title": "", "base_domain": "webaim.org", "head_data": null, "head_extraction_status": null, "head_extraction_error": null, "intrinsic_score": 0.0, "contextual_score": null, "total_score": null}, {"href": "https://conference.webaim.org/", "text": "Home", "title": "", "base_domain": "webaim.org", "head_data": null, "head_extraction_status": null, "head_extraction_error": null, "intrinsic_score": 0.0, "contextual_score": null, "total_score": null}, {"href": "https://conference.webaim.org/speakers", "text": "Speakers", "title": "", "base_domain": "webaim.org", "head_data": null, "head_extraction_status": null, "head_extraction_error": null, "intrinsic_score": 0.0, "contextual_score": null, "total_score": null}, {"href": "https://conference.webaim.org/register", "text": "REGISTER", "title": "", "base_domain": "webaim.org", "head_data": null, "head_extraction_status": null, "head_extraction_error": null, "intrinsic_score": 0.0, "contextual