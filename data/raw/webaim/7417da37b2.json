{"url": "https://webaim.org/training/online/sample/course/registration", "silo": "webaim", "html": "<!DOCTYPE html><html lang=\"en\"><head>\n\t<meta charset=\"utf-8\">\n\t<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n\t\t<title>WebAIM: WebAIM Accessible Document Training</title>\n\t<link rel=\"shortcut icon\" href=\"/media/favicon.ico\">\n\t<link rel=\"home\" href=\"/\">\n\t<link rel=\"search\" href=\"/search/\">\n\t<link rel=\"alternate\" href=\"https://webaim.org/blog/feed\" type=\"application/rss+xml\" title=\"WebAIM Blog\">\n\n\t<script async=\"\" src=\"https://www.googletagmanager.com/gtag/js?id=G-Y41PF8WV9X\"></script>\n\t<script>\n  \twindow.dataLayer = window.dataLayer || [];\n  \tfunction gtag(){dataLayer.push(arguments);}\n  \tgtag('js', new Date());\n  \tgtag('config', 'G-Y41PF8WV9X');\n\t</script>\n\t\n\t<link href=\"/styles/main.css\" rel=\"stylesheet\" type=\"text/css\">\n\t<link href=\"/styles/print.css\" rel=\"stylesheet\" type=\"text/css\" media=\"print\">\n\t<script src=\"/media/scripts/jquery.js\"></script>\n\t<script src=\"/media/scripts/main.js\"></script>\n\t<link href=\"https://fonts.googleapis.com/css?family=Roboto:400\" rel=\"stylesheet\" type=\"text/css\">\n\t<link href=\"https://fonts.googleapis.com/css?family=Kameron:400,700\" rel=\"stylesheet\" type=\"text/css\">\n\t<link href=\"/styles/documents.css?ver=2\" rel=\"stylesheet\">\n\t\t<link href=\"https://fonts.googleapis.com/css?family=Open+Sans:400,400i,700\" rel=\"stylesheet\">\n\n<style>\n.section input {\n\tmargin-left: 1em;\n}\n.section label span {\n\tcolor: #BF1722;\n\tfloat: none;\n\tfont-size: 1.5em;\n\tline-height: 1;\n\tmargin-top: 0.2em;\n\tvertical-align: middle;\n}\n\n.section h3 {\n\tclear:right;\n}\n.section input[type=text], .section select, .section textarea {\n\tborder-radius:3px;\n\tborder:1px solid #bbb;\n\tpadding:3px;\n}\ninput[type=submit] {\n    padding:5px 15px; \n    font-weight:bold;\n    background:#eee; \n    border:1px solid #ccc;\n    cursor:pointer;\n    border-radius: 5px; \n}\ndiv nav {\n\tdisplay: none;\n}\ndiv#search, div#headcontainer {\n\tdisplay: none;\n}\narticle#maincontent h1 {\n\tmargin: 2em 0 1.5em 0;\n}\ndiv#register h2, div#overview h2, div#delivery h2 {\n\tmargin-bottom: .5em;\n}\n.logos {\n\tmargin-top:2.5em;\n}\n.canvas {\n\tmargin: 0 .5em 1em 2.5em;\n}\n.sample {\n\tmargin: -1.5em 0 0 0em;\n}\ndiv.margin {\n\tmargin: 2.5em 0 1.5em 0;\n}\n.important {\n\tborder-color: #333333;\n}\n.important .note {\n\tpadding: 12px 1.5em 0px 1.5em;\n}\n.important .notes {\n\tbackground:url(../../../docs/images/bg_important.svg) no-repeat;\n\tcolor:#333333;\n\tpadding:3px 0 15px 50px;\n\tdisplay:block;\n\tfont-weight: bold;\n\tfont-size: 1.25em;\n}\ninput#submit {\n\tmargin: 2em;\n}\np.aboveList {\n\tpadding-bottom: 0;\n\tmargin-bottom: 1em;\n}\ndiv.row {\n\tmargin-left: .5em;\n}\ninput[type=submit] {\n    padding: 5px 15px;\n    font-weight: bold;\n    background: #666;\n    border: 1px solid #666;\n    cursor: pointer;\n    border-radius: 5px;\n}\nlabel {\n\tfont-weight: bold;\n}\ndiv.logo {\n\theight: 106px;\n\tmargin-bottom: 2em;\n\t}\nlegend.role {\n\tmargin-bottom: .75em;\n\tfont-size: 1em;\n}\nselect#college {\n\tmargin-top: 1em;\n}\ninput.hidden {\n\tdisplay: none;\n}\nli.space {\n  margin-bottom: .75em;\n}\n\n</style>\n\n<!--[if lt IE 9]>\n\t<script type=\"text/javascript\" src=\"http://html5shiv.googlecode.com/svn/trunk/html5.js\"></script>\n<![endif]-->\n<script type=\"text/javascript\" async=\"\" src=\"https://googleads.g.doubleclick.net/pagead/viewthroughconversion/1069381703/?random=1774677558297&amp;cv=11&amp;fst=1774677558297&amp;bg=ffffff&amp;guid=ON&amp;async=1&amp;en=gtag.config&amp;gtm=45je63p1v899903185za200zd899903185xec&amp;gcd=13l3l3l3l1l1&amp;dma=0&amp;tag_exp=0~115938465~115938469~117384406~117484252&amp;u_w=1080&amp;u_h=600&amp;url=https%3A%2F%2Fwebaim.org%2Ftraining%2Fonline%2Fsample%2Fcourse%2Fregistration&amp;frm=0&amp;tiba=WebAIM%3A%20WebAIM%20Accessible%20Document%20Training&amp;hn=www.googleadservices.com&amp;npa=0&amp;pscdl=noapi&amp;auid=1598495543.1774677300&amp;uaa=x86&amp;uab=64&amp;uafvl=Chromium%3B145.0.7632.6%7CNot%253AA-Brand%3B99.0.0.0&amp;uamb=0&amp;uam=&amp;uap=Linux&amp;uapv=&amp;uaw=0&amp;data=event%3Dgtag.config&amp;rfmt=3&amp;fmt=4\"></script></head>\n<body>\n\n\n<div id=\"headcontainer\" class=\"clearfix\" style=\"background-image: url(/media/banners/empty.jpg)\">\n<header>\n\t<div id=\"skiptocontent\"><a href=\"#maincontent\">skip to main content</a></div>\n\t\n\t<h2><a href=\"/\"><img src=\"/media/logo.png\" width=\"315\" height=\"83\" alt=\"WebAIM - Web Accessibility In Mind\"></a></h2>\n\n\t<nav>\n\t\t<h2 class=\"hidden\">Main Navigation</h2>\n\t\t<ul>\n\t\t\t<li><a href=\"/services/\">Services</a></li>\n\t\t\t<li><a href=\"/articles/\">Articles</a></li>\n\t\t\t<li><a href=\"/resources/\">Resources</a></li>\n\t\t\t<li><a href=\"/projects/\">Projects</a></li>\n\t\t\t<li><a href=\"/community/\">Community</a></li>\n\t\t</ul>\n\t</nav>\n\t<div id=\"search\">\n\t\t<form method=\"get\" role=\"search\" action=\"/search/\" id=\"sitesearch\">\n\t\t\t<p class=\"search\"><span><label for=\"q\">Search:</label> <input type=\"text\" name=\"q\" id=\"q\"><input type=\"image\" src=\"/media/template/search.svg\" alt=\"Submit Search\"></span></p>\n\t\t</form>\n\t\t\n\t\t<p class=\"intro\"><a href=\"/intro\">Introduction to Web Accessibility</a></p>\n\t\t\n\t\t<p class=\"training\"><a href=\"/services/training\">WebAIM Training</a></p>\n\t</div>\n\n</header>\n</div>\n\n<main id=\"maincontainer\" class=\"clearfix\">\n\n<article id=\"maincontent\">\n\n<h1>WebAIM Accessible Document Training</h1>\n\n<link rel=\"stylesheet\" href=\"https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css\">\n\n\n<p><img src=\"sample-logo-175.png\" alt=\"Your Logo\" width=\"175\" height=\"175\" class=\"floatright sample\"></p>\n\t\n<p>[This is a sample custom registration page]</p>\n<p>Your enrollment into the <a href=\"../../../docs/\">Accessible Documents: Word, PowerPoint, &amp; Acrobat</a> online training course is being provided by [Client].</p>\n\n<div class=\"section\" id=\"overview\">\n\t<h2>Overview</h2>\n\t<p class=\"aboveList\">This independent-study course covers principles and processes for:\n\t<img src=\"../../../docs/images/listing.png\" alt=\"Word, PowerPoint, &amp; Acrobat logos\" width=\"1050\" height=\"768\" class=\"floatright logos\"></p>\n\t<ul class=\"half\">\n\t\t<li><strong>Creating</strong> accessible document content and structure in Word &amp; PowerPoint.</li>\n\t\t<li><strong>Evaluating</strong> the accessibility of well-structured Word &amp; PowerPoint documents.</li>\n\t\t<li><strong>Optimizing</strong> the accessibility of PDFs exported from well-structured Word &amp; PowerPoint documents with Acrobat.</li>\n\t\t<li><strong>Creating</strong> accessible document content and structure in Excel (bonus module).</li>\n\t</ul>\n\t<p>This course is designed for participants that have experience creating Word &amp; PowerPoint documents. Web development or design experience is not required.</p>\n</div>\n\n\n<div class=\"section\" id=\"delivery\">\n\t<h2>Delivery</h2>\n\t\t<p><a href=\"https://www.instructure.com/product/higher-education/canvas-catalog\"><img src=\"../../../docs/images/canvas.png\" alt=\"canvas\" width=\"120\" height=\"150\" class=\"floatright canvas\"></a>\n\t\t<span>The course is delivered through the Canvas learning management system. Enrolled participants have 24/7 access to technical support for Canvas in English and Spanish. New cohorts start on the <strong>first Monday</strong> of each month unless there is a U.S. holiday that week.</span>\n\n</p></div>\t\n\n\t<div class=\"important margin\">\n\t\t<div class=\"notes\">\n\t\t\tPlease note\n\t\t</div>\n\t\t<ul>\n\t\t\t<li class=\"space\">Participants have <strong>60 business days</strong> to complete the course.</li>\n\t\t\t<li class=\"space\">Participants must register with a <strong>[Client]</strong> email.</li>\n\t\t\t<li><em>Problems registering?</em> Email us at <strong>accessibledocs[at]webaim.org</strong>.</li>\n\t\t</ul>\n\t</div>\n\n<div class=\"section\" id=\"register\">\n\t<h2>Register</h2>\n\t\n\t<p class=\"aboveList\">To register please provide us with the following information\u2014</p>\n\t\n\n\t<form action=\"https://api.sheetmonkey.io/form/XXXXXXXXX\" method=\"POST\">\n\t\t\n\t\t\t\n\t\t\t<input type=\"hidden\" name=\"Submitted\" value=\"2026-03-28 05:59:17\" readonly=\"readonly\">\n\t\t\t<input type=\"hidden\" name=\"Enrolled\" value=\"-\">\n\t\t\t<label for=\"cohort\">Month to start training:</label><br>\n\t\t\t<select id=\"cohort\" name=\"Cohort\" class=\"form-control name_cohort\" style=\"width:8em;\" required=\"\"><option value=\"7\">July</option><option value=\"8\">August</option></select><br>\n\t\t\t<input type=\"hidden\" name=\"Year\" value=\"23\">\n\t\t\n\t\t\t<label for=\"first\">First name:</label><br>\n\t\t\t<input type=\"text\" id=\"first\" name=\"First\" class=\"form-control name_fname\" style=\"width:15em;\" required=\"\"><br>\n\t\t\n\t\t\t<label for=\"last\">Last name:</label><br>\n\t\t\t<input type=\"text\" id=\"last\" name=\"Last\" class=\"form-control name_lname\" style=\"width:15em;\" required=\"\"><br>\n\n\t\t\t<label for=\"email\">Email:</label><br>\n\t\t\t<input type=\"text\" id=\"email\" name=\"Email\" class=\"form-control name_email\" style=\"width:25em;\" required=\"\"><br>\n\t\t\n<!--\n\t\t\t<fieldset>\n\t\t\t\t<legend class=\"role\"><strong>Are you faculty or staff?</strong></legend>\n\t\t\t\t<input type=\"radio\" id=\"faculty\" name=\"Role\" value=\"faculty\" required>\n\t\t\t\t<label for=\"faculty\">Faculty</label><br>\n\t\t\t\t<input type=\"radio\" id=\"staff\" name=\"Role\" value=\"staff\">\n\t\t\t\t<label for=\"staff\">Staff</label><br><br>\n\t\t\t</fieldset>\n-->\n\t\t\t\n\t\t\t<label for=\"unit\">Please select your unit's name:</label><br>\n\t\t\t<select id=\"unit\" name=\"Unit\" class=\"form-control name_unit\" style=\"width:15em;\" required=\"\">\t\t\n\t\t\t\t<option value=\"Unit 1\">Unit 01</option>\n\t\t\t\t<option value=\"Unit 02\">Unit 02</option>\n\t\t\t\t<option value=\"Unit 03\">Unit 03</option>\n\t\t\t\t<option value=\"Unit 04\">Unit 04</option>\n\t\t\t\t<option value=\"Unit 05\">Unit 05</option>\n\t\t\t\t<option value=\"Unit 06\">Unit 06</option>\n\t\t\t\t<option value=\"Unit 07\">Unit 07</option>\n\t\t\t\t<option value=\"Unit 08\">Unit 08</option>\n\t\t\t\t<option value=\"Unit 09\">Unit 09</option>\n\t\t\t\t<option value=\"Unit 10\">Unit 10</option>\n\t\t\t\t<option value=\"Unit 11\">Unit 11</option>\n\t\t\t\t<option value=\"Unit 12\">Unit 12</option>\n\t\t\t\t<option value=\"Unit 13\">Unit 13</option>\n\t\t\t\t<option value=\"Unit 14\">Unit 14</option>\n\t\t\t\t<option value=\"Unit 15\">Unit 15</option>\t\t\t\n\t\t\t</select>\n\t\t\t\t\n\t\t\t<input type=\"submit\" class=\"btn btn-success\" id=\"submit\" value=\"Submit\">\n\n\t</form>\n\t\n\t\n</div>\n  \n\n\n\n\n\n<script src=\"https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js\"></script>\n<script src=\"https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js\"></script>\n</article></main><flying-focus id=\"flying-focus\" style=\"transition-duration: 0.1s;\"></flying-focus></body></html>", "links": [{"href": "https://webaim.org/training/online/sample/course/registration", "text": "skip to main content", "title": "", "base_domain": "webaim.org", "head_data": null, "head_extraction_status": null, "head_extraction_error": null, "intrinsic_score": 0.0, "contextual_score": null, "total_score": null}, {"href": "https://webaim.org/", "text": "", "title": "", "base_domain": "webaim.org", "head_data": null, "head_extraction_status": null, "head_extraction_error": null, "intrinsic_score": 0.0, "contextual_score": null, "total_score": null}, {"href": "https://webaim.org/services/", "text": "Services", "title": "", "base_domain": "webaim.org", "head_data": null, "head_extraction_status": 