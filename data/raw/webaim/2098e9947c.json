{"url": "https://wave.webaim.org/feedback", "silo": "webaim", "html": "<!DOCTYPE html><html lang=\"en\"><head>\n\t<meta charset=\"utf-8\">\n\t<title>WAVE Feedback</title>\n\t<script src=\"/js/index.js\"></script>\n\t<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n\t<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin=\"\">\n\t<link href=\"https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300..800;1,300..800&amp;display=swap\" rel=\"stylesheet\">\n\t<link rel=\"stylesheet\" href=\"/styles/index.css?ver=3.2\" type=\"text/css\">\n\t<link rel=\"shortcut icon\" href=\"/favicon.ico\">\n</head>\n<body>\n<header>\n<nav>\n<ul>\n\t<li><a href=\"/extension\">Browser Extensions</a></li>\n\t<li><a href=\"/standalone\">Stand-alone API/Testing Engine</a></li>\n\t<li><a href=\"/api\">Subscription API</a></li>\n\t<li><a href=\"/aim\">AIM Report</a></li>\n\t<li><a href=\"/help\">Help</a></li>\n</ul>\n<a href=\"/\"><img src=\"/img/wavelogo.svg\" alt=\"WAVE Web Accessibility Evaluation Tool\" height=\"69\" width=\"182\"></a>\n</nav>\n<div id=\"main_form\" class=\"controls\">\n<form id=\"waveform\" novalidate=\"\">\n<label for=\"input_url\">Web page address:</label><br><input id=\"input_url\" type=\"url\" class=\"control url\"><input class=\"control\" type=\"submit\" id=\"button_wave\" value=\"WAVE\">\n</form>\n</div>\n</header>\n<main>\n\n\n\t<span style=\"float:right;\">\n\t</span>\n\t<div style=\"clear:both;\"></div>\n<h1>WAVE Feedback</h1>\n<div class=\"controls\">\n\n<form method=\"post\" action=\"feedback\" style=\"margin-top:10px;\">\n\n\t<div>\n\t\t<label for=\"sender\">Your Name:</label>\n\t\t<br>\n\t\t<input name=\"sender\" type=\"text\" class=\"control text\" id=\"sender\" value=\"\" size=\"47\">\n\t</div>\n\t<div>\n\t\t<label for=\"email\">Your E-mail Address: </label>\n\t\t<br>\n\t\t<input name=\"email\" type=\"text\" class=\"control text\" id=\"email\" value=\"\" size=\"47\">\n\t</div>\n\t<div>\n\t\t<label for=\"subject\">Subject:</label>\n\t\t<br>\n\t\t<input name=\"subject\" type=\"text\" class=\"control text\" id=\"subject\" value=\"\" size=\"67\">\n\t</div>\n\t<div>\n\t\t<label for=\"url\">URL in question (if applicable):</label>\n\t\t<br>\n\t\t<input name=\"url\" type=\"text\" class=\"control text\" id=\"url\" value=\"\" size=\"67\">\n\t</div>\n\t<div>\n\t\t<label for=\"message\">Message:</label>\n\t\t<br>\n\t\t<textarea id=\"message\" name=\"message\" class=\"control text\" cols=\"47\" rows=\"6\"></textarea>\n\t\t<br>\n\t\t\n\t\t<input type=\"submit\" name=\"Submit\" value=\"Send Message\" class=\"control button\">\n\t\t<span style=\"display:none;visibility:hidden;\"><br>\n\t\t\t<label for=\"emailaddress\">Ignore this form element. It is used to detect spambots. If you enter anything into this text box, your report will not be processed.</label>\n\t\t\t<input type=\"text\" id=\"emailaddress\" name=\"emailaddress\" size=\"1\" value=\"\">\n\t\t</span>\n\t\t<input type=\"hidden\" name=\"currenttime\" value=\"1774677612\">\n\t</div>\n</form>\n\n</div>\n\n</main>\n<footer>\n\t<div class=\"footerblock\"><a href=\"https://usu.edu/\"><img src=\"/img/web/usu-logo.svg\" alt=\"Utah State University\" style=\"width:70%;\" width=\"504\" height=\"196\"></a></div>\n\t<div class=\"footerblock middle\"><a href=\"https://webaim.org/\"><img src=\"/img/web/WebAIM-logo.svg\" alt=\"WebAIM - Web Accessibility in Mind\"></a><br>\n\t\tUtah State University<br>\n\t\t6807 Old Main Hill<br>\n\t\tLogan, UT 84322-6807<br>\n\t\t435.797.7024</div>\n\t<div class=\"footerblock\" id=\"footerlinks\">\n\t\t<ul>\n\t\t\t<li id=\"contact\"><a href=\"/feedback\">Contact Us</a></li>\n\t\t\t<li id=\"sitewide\"><a href=\"/sitewide\">Site-wide WAVE Tools</a></li>\n\t\t\t<li id=\"about\"><a href=\"/about\">About</a></li>\n\t\t\t<li id=\"terms\"><a href=\"/terms\">Terms of Use</a></li>\t\t\n\t\t</ul>\n\t</div>\n\t\n\t<div id=\"copyright\">\n\t\tWAVE is \u00a9 and \u00ae 2026\t</div>\n\t\n\t\n</footer>\n\n\n\n\n\t</body></html