{"url": "https://w3c.github.io/aria-practices/", "silo": "aria", "html": "<!DOCTYPE html><html lang=\"en\"><head>\n  <meta charset=\"UTF-8\">\n  <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Content Moved</title>\n  <style>\n    #redirects a {\n      text-decoration: none;\n    }\n    #redirects span {\n      display: block;\n    }\n    #redirects span a:focus {\n      border: 3px solid cornflowerblue;\n      outline: none;\n    }\n  </style>\n</head>\n<body>\n  <h1>Content Moved</h1>\n  <p>The content previously found at this location has been moved to the following pages:</p>\n  <div id=\"redirects\"></div>\n  <script type=\"module\">\n    (async () => {\n      const redirects = (await import('./redirects.js')).default\n\n      let html = ''\n      redirects.forEach(({ redirect: hashes, to, name }) => {\n        hashes.forEach(hash => {\n          html += `<span id=\"${hash}\">`\n        })\n\n        html += `<div><a href=\"${to}\">${name}</a></div>`\n\n        hashes.forEach(hash => {\n          html += `</span>`\n        })\n      })\n\n      document.querySelector('#redirects').innerHTML = html\n\n      if (!document.location.hash) return\n      const focusedElement = document.querySelector(`${document.location.hash} a`)\n      focusedElement?.focus()\n      focusedElement?.scrollIntoView()\n    })()\n  </script>\n\n</body></html>", "links": []}